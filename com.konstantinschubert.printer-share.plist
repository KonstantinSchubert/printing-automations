<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.konstantinschubert.printer-share</string>

  <!-- Runs as the logged-in user: they are in the _lpadmin group, so lpadmin
       can flip printer-is-shared without root. No LaunchDaemon needed. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/konstantinschubert/printing/ensure-printer-shared.sh</string>
  </array>

  <!-- Runs once at login and exits -- no polling, no resident process.
       Every reset observed so far came from a macOS update or reboot, so
       login is exactly when the repair is needed. If the flag ever turns
       out to flip mid-session, add a StartInterval here (seconds). -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/konstantinschubert/printing/printer-share.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/konstantinschubert/printing/printer-share.log</string>
</dict>
</plist>
