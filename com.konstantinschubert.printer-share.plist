<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.konstantinschubert.printer-share</string>

  <!-- Runs as the logged-in user: they are in the _lpadmin group, so lpadmin
       can flip printer-is-shared without root. No LaunchDaemon needed. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/konstantinschubert/printing/ensure-printer-shared.sh</string>
  </array>

  <!-- At login: catches the reset that macOS updates leave behind. -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Every 10 minutes: catches a reset that happens while running.
       The script exits silently when the flag is already true. -->
  <key>StartInterval</key>
  <integer>600</integer>

  <key>StandardOutPath</key>
  <string>/Users/konstantinschubert/printing/printer-share.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/konstantinschubert/printing/printer-share.log</string>
</dict>
</plist>
